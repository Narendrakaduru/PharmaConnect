<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- ═══════════════════════════════════════════════════════════════
         CRITERIA-BASED SHARING RULES — Healthcare_Provider__c
         OWD: Private
         Strategy: Share territory records with the Role that covers
                   that territory. Using roleAndSubordinates ensures these
                   rules deploy cleanly across all pipeline environments
                   without requiring pre-existing Public Group data records.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Hyderabad Central: Shared with Medical Representative role and upward -->
    <sharingCriteriaRules>
        <fullName>Share_Hyderabad_Central_HCPs_Role</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Shares Healthcare Providers in Hyderabad Central territory with the Medical Representative - Hyderabad role and subordinates. Read/Write access via role hierarchy.</description>
        <label>Share Hyderabad Central HCPs</label>
        <sharedTo>
            <roleAndSubordinates>Medical_Representative_Hyderabad</roleAndSubordinates>
        </sharedTo>
        <criteriaItems>
            <field>Territory__c</field>
            <operation>equals</operation>
            <value>Hyderabad Central</value>
        </criteriaItems>
    </sharingCriteriaRules>

