<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_Hyderabad_Central_HCPs</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Shares Healthcare Providers in Hyderabad Central territory with the Hyderabad Central Public Group (Read/Write access).</description>
        <label>Share Hyderabad Central HCPs</label>
        <sharedTo>
            <group>Group_Territory_Hyderabad_Central</group>
        </sharedTo>
        <criteriaItems>
            <field>Territory__c</field>
            <operation>equals</operation>
            <value>Hyderabad Central</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_Hyderabad_Central_HCPs_Role</fullName>
        <accessLevel>Edit</accessLevel>
        <description>Shares Healthcare Providers in Hyderabad Central territory with the Medical Representative - Hyderabad role and subordinates. Read/Write access via role hierarchy.</description>
        <label>Share Hyderabad Central HCPs</label>
        <sharedTo>
            <roleAndSubordinatesInternal>Medical_Representative_Hyderabad</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>Territory__c</field>
            <operation>equals</operation>
            <value>Hyderabad Central</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>false</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
