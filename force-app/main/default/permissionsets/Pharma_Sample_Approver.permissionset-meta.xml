<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Sample compliance manager access. Read/Edit on Sample_Request__c to review and approve requests. Read-only on related HCP, Medical Rep, and Product objects for context. No Create, Delete, Modify All, or View All.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Pharma Sample Approver</label>
    <license>Salesforce</license>

    <!-- ═══════════════════════════════════════════
         OBJECT PERMISSIONS
         ═══════════════════════════════════════════ -->

    <!-- Sample_Request__c: Read/Edit (review and update approval status) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Sample_Request__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Healthcare_Provider__c: Read-only (who is receiving samples) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Healthcare_Provider__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Medical_Representative__c: Read-only (who submitted the request) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Medical_Representative__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Product2: Read-only (which product is being requested) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ═══════════════════════════════════════════
         FIELD PERMISSIONS
         NOTE: Required fields (required=true in field XML) are excluded.
         Salesforce auto-grants required fields to all users with object access.
         Excluded required fields:
           Sample_Request__c: Healthcare_Provider__c, Medical_Representative__c,
                              Quantity__c
           Healthcare_Provider__c: Provider_Name__c, Provider_Type__c
           Medical_Representative__c: Employee_ID__c, Region__c
           Product2: Formulation__c, Strength__c, Therapeutic_Class__c, Pack_Size__c
         ═══════════════════════════════════════════ -->

    <!-- Sample_Request__c — non-required fields -->
    <!-- Status, Approved_By__c, Approval_Date__c: editable (approver drives flow) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Sample_Request__c.Approval_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sample_Request__c.Approved_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Sample_Request__c.Product__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Sample_Request__c.Request_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Sample_Request__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Healthcare_Provider__c — non-required fields (read-only context) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Healthcare_Provider__c.Account__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Healthcare_Provider__c.Specialization__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Healthcare_Provider__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Healthcare_Provider__c.Territory__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Medical_Representative__c — non-required fields (read-only context) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Medical_Representative__c.Manager__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Medical_Representative__c.Territory__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Product2 — non-required custom fields (read-only context) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Product2.Available_Stock__c</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
