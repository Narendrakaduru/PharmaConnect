<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Product master data maintenance access. Grants Create/Read/Edit/Delete on Product2 and edit access to non-required PharmaConnect Product2 custom fields. [Updated for Sandbox Review]</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Pharma Product Catalog Admin</label>
    <license>Salesforce</license>

    <!-- ═══════════════════════════════════════════
         OBJECT PERMISSIONS
         ═══════════════════════════════════════════ -->

    <!-- Product2: Full CRUD for catalog management -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Account: Read-only (context for product-account relationships) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ═══════════════════════════════════════════
         FIELD PERMISSIONS
         NOTE: Required fields (required=true in field XML) are excluded.
         Salesforce auto-grants required fields to all users with object access.
         Excluded required Product2 fields:
           Formulation__c, Strength__c, Therapeutic_Class__c, Pack_Size__c
         ═══════════════════════════════════════════ -->

    <!-- Product2 — non-required custom fields (editable) -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Available_Stock__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Contraindications__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Dosage_Information__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Indications__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Product2.Key_Benefits__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Account — custom fields (read-only context) -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Active__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Drug_License_Number__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Territory__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Tier__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Dummy entry to register changes for sandbox review / DevOps Center tracking -->
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Description</field>
        <readable>true</readable>
    </fieldPermissions>
</PermissionSet>
