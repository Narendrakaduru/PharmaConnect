        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Medical_Representative__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Doctor_Visit__c: Create/Read/Edit (log field calls) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Doctor_Visit__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Product_Discussion__c: Create/Read/Edit (detail lines on visits) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
