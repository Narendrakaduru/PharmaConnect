<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Base field-force operational access for Medical Representatives. Grants Read on standard objects and Create/Read/Edit on all field-operation custom objects. Follows least-privilege: no View All, Modify All, or Delete granted.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Pharma Representative Access</label>
    <license>Salesforce</license>

    <!-- ═══════════════════════════════════════════
         OBJECT PERMISSIONS
         ═══════════════════════════════════════════ -->

    <!-- Account: Read-only (clinic/hospital directory) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Contact: Read-only (key hospital staff) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Product2: Read-only (medicine catalog) -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Healthcare_Provider__c: Create/Read/Edit (manage assigned doctors) -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Healthcare_Provider__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Medical_Representative__c: Read-only (lookup context, own profile) -->
